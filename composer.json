{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "automoveisconfiaveis/laravel-dynamodb",
    "description": "DynamoDB driver for Laravel with automatic index resolution and Eloquent support",
    "keywords": [
        "laravel",
        "dynamodb",
        "aws",
        "database",
        "driver",
        "eloquent",
        "index",
        "gsi",
        "lsi"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/automoveisconfiaveis/package-laravel-dynamodb",
    "support": {
        "issues": "https://github.com/automoveisconfiaveis/package-laravel-dynamodb/issues",
        "source": "https://github.com/automoveisconfiaveis/package-laravel-dynamodb"
    },
    "authors": [
        {
            "name": "Automóveis Confiáveis",
            "email": "contato@autoconf.com.br"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "aws/aws-sdk-php": "^3.322.9"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AutomoveisConfiaveis\\LaravelDynamoDb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AutomoveisConfiaveis\\LaravelDynamoDb\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AutomoveisConfiaveis\\LaravelDynamoDb\\DynamoDbServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
